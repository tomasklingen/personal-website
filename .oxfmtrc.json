{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 80,
	"tabWidth": 2,
	"useTabs": true,
	"semi": false,
	"singleQuote": true,
	"sortPackageJson": false,
	"astro": true,
	"overrides": [
		{
			"files": ["**/*.jsonc"],
			"options": {
				"trailingComma": "none"
			}
		}
	]
}
