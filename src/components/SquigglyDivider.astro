---
interface Props {
	class?: string
}

const { class: className = '' } = Astro.props

const period = 30
const start = -20
const segments = 12

// Extends past the visible area so a one-period shift loops without gaps.
const wavePath = `M${start} 10${Array.from({ length: segments }, (_, index) => {
	const x = start + index * period
	return `C${x + 10} 5 ${x + 20} 15 ${x + period} 10`
}).join('')}`
---

<div class={`w-full flex justify-center py-6 ${className}`}>
	<svg
		width="300"
		height="20"
		viewBox="0 0 300 20"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		class="text-amber-400 dark:text-amber-500 [clip-path:inset(0_10px)]"
	>
		<path
			class="wave"
			d={wavePath}
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			fill="none"
		></path>
	</svg>
</div>

<style define:vars={{ period: `${period}px` }}>
	.wave {
		animation: squiggle 1s linear infinite paused;
	}

	svg:hover .wave {
		animation-play-state: running;
	}

	@keyframes squiggle {
		to {
			transform: translateX(var(--period));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.wave {
			animation: none;
		}
	}
</style>
