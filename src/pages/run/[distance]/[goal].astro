---
import type { GetStaticPaths } from 'astro'
import Footer from '~/components/Footer.astro'
import Link from '~/components/Link.astro'
import PaceTable from '~/components/PaceTable.astro'
import RunHeader from '~/components/RunHeader.astro'
import SquigglyDivider from '~/components/SquigglyDivider.astro'
import Layout from '~/layouts/Layout.astro'
import { generateWebPageSchema } from '~/lib/structured-data'
import {
	distanceConfig,
	getSubGoalPath,
	type SubGoal,
	subGoals,
} from '~/running/data'
import {
	formatTime,
	generatePaceEntries,
	generateSplits,
	getGoalPaceEntry,
} from '~/running/utils'

export const getStaticPaths: GetStaticPaths = () => {
	return subGoals.map((subGoal) => {
		const chart = distanceConfig.find(
			({ slug }) => slug === subGoal.distanceSlug,
		)
		if (!chart) {
			throw new Error(`Unknown distance "${subGoal.distanceSlug}"`)
		}

		return {
			params: { distance: subGoal.distanceSlug, goal: subGoal.slug },
			props: { subGoal, distance: chart.distance, distanceLabel: chart.label },
		}
	})
}

interface Props {
	subGoal: SubGoal
	distance: number
	distanceLabel: string
}

const { subGoal, distance, distanceLabel } = Astro.props
const {
	distanceSlug,
	label,
	threshold,
	goalText,
	finishSeconds,
	checkpoints,
	negativeSplit,
	nearbyRanges,
} = subGoal

const path = getSubGoalPath(subGoal)
const halfDistance = distance / 2
const paceSeconds = finishSeconds / distance
const target = getGoalPaceEntry(finishSeconds, distance)

// Round up, so holding the speed finishes under the goal time.
const speed = (
	Math.ceil((distance / (finishSeconds / 3600)) * 10) / 10
).toFixed(1)
const lapTime = formatTime(Math.floor(paceSeconds * 0.4))
const wholeSecondPace = Math.floor(paceSeconds)
const wholeSecondPaceFinish = formatTime(wholeSecondPace * distance)
const slowerPace = formatTime(wholeSecondPace + 1)
const slowerPaceFinish = formatTime((wholeSecondPace + 1) * distance)

// The no-break space keeps the number and the unit on one line.
const distanceText = `${distance} km`

// These are strings, because Astro drops a line break between an expression and text.
const intro = `${goalText} That is a pace of ${target.pacePerKm} per km or faster for ${distanceText}.`
const splitsIntro = `Pass each checkpoint at the time shown to finish in ${target.time}. Use the list as a pace band on race day.`
const marginNote = [
	`Holding ${target.pacePerKm} per km for ${distanceText} gives a finish of ${wholeSecondPaceFinish}.`,
	`A pace of ${slowerPace} per km is already too slow. It gives ${slowerPaceFinish}.`,
	`Most runners cover more than ${distanceText}, because they cannot run the shortest line.`,
	'Plan a few seconds per km of margin.',
].join(' ')
const chartLinkText = `See the full ${distanceLabel.toLowerCase()} pace chart →`

const stats = [
	{ value: target.pacePerKm, unit: 'per km' },
	{ value: target.pacePerMile, unit: 'per mile' },
	{ value: speed, unit: 'km/h' },
	{ value: lapTime, unit: '400 m lap' },
]

const splits = generateSplits(checkpoints, paceSeconds)

const secondHalfSeconds = finishSeconds - negativeSplit.firstHalfSeconds
const strategies = [
	{
		name: 'Even pace',
		description: 'Run every kilometer at the same pace.',
		firstHalfPace: target.pacePerKm,
		secondHalfPace: target.pacePerKm,
		halfwayTime: formatTime(Math.floor(halfDistance * paceSeconds)),
	},
	{
		name: 'Negative split',
		description: negativeSplit.description,
		firstHalfPace: getGoalPaceEntry(
			negativeSplit.firstHalfSeconds,
			halfDistance,
		).pacePerKm,
		secondHalfPace: getGoalPaceEntry(secondHalfSeconds, halfDistance).pacePerKm,
		halfwayTime: formatTime(negativeSplit.firstHalfSeconds),
	},
]

const nearbyEntries = [
	...generatePaceEntries(nearbyRanges.faster, distance),
	target,
	...generatePaceEntries(nearbyRanges.slower, distance),
]

const pageTitle = `${label} Pace`
const description = `A ${label.toLowerCase()} needs a pace of ${target.pacePerKm} per kilometer or ${target.pacePerMile} per mile. See the splits, two pacing options and finish times near ${threshold}.`
const structuredData = generateWebPageSchema({
	name: pageTitle,
	description,
	url: new URL(path, Astro.site).href,
})
---

<Layout
	title={`${pageTitle}: ${target.pacePerKm} per km, ${target.pacePerMile} per mile - Tomas Klingen`}
	description={description}
	structuredData={structuredData}
>
	<main class="container mx-auto flex flex-col transition-colors">
		<RunHeader title={pageTitle} currentPath={path} />

		<section class="px-4 pt-6">
			<div class="rounded-2xl bg-linear-to-br from-emerald-700 to-emerald-900 p-6 text-white shadow-xl md:p-8 dark:from-emerald-600/30 dark:to-neutral-800 dark:ring-1 dark:ring-emerald-400/30">
				<p class="text-sm font-semibold uppercase tracking-widest text-emerald-100 dark:text-emerald-300">
					My goal
				</p>
				<p class="mt-2 font-header text-6xl font-bold tabular-nums sm:text-7xl">
					{target.time}
				</p>
				<p class="mt-3 text-emerald-50 dark:text-neutral-200">{intro}</p>
				<dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
					{stats.map(({ value, unit }) => (
						<div class="rounded-xl bg-white/10 p-4 ring-1 ring-white/20">
							<dt class="text-xs font-semibold uppercase tracking-wide text-emerald-100 dark:text-emerald-300">
								{unit}
							</dt>
							<dd class="mt-1 font-header text-3xl font-bold tabular-nums">
								{value}
							</dd>
						</div>
					))}
				</dl>
			</div>
		</section>

		<SquigglyDivider />

		<section class="px-4 text-neutral-700 dark:text-neutral-300">
			<h2 class="text-2xl font-bold text-neutral-900 dark:text-white">
				🏁 Splits at even pace
			</h2>
			<p class="mt-2">{splitsIntro}</p>
			<ol class="mt-6 rounded-2xl bg-white p-4 shadow dark:bg-neutral-800">
				{splits.map(({ label: splitLabel, miles, elapsed, isMilestone }) => (
					<li class="relative flex items-center justify-between gap-4 py-3 pl-8 before:absolute before:inset-y-0 before:left-[7px] before:w-0.5 before:bg-emerald-200 first:before:top-1/2 last:before:bottom-1/2 dark:before:bg-emerald-900">
						<span
							aria-hidden="true"
							class={`absolute left-0 top-1/2 size-4 -translate-y-1/2 rounded-full ring-4 ring-white dark:ring-neutral-800 ${
								isMilestone
									? 'bg-amber-400 dark:bg-amber-500'
									: 'bg-emerald-500 dark:bg-emerald-400'
							}`}
						/>
						<div>
							<p
								class={`font-semibold text-neutral-900 dark:text-white ${
									isMilestone ? 'text-lg' : ''
								}`}
							>
								{splitLabel}
							</p>
							<p class="text-sm text-neutral-500 dark:text-neutral-400">
								{miles} mi
							</p>
						</div>
						<p
							class={`font-header text-2xl font-bold tabular-nums ${
								isMilestone
									? 'text-amber-700 dark:text-amber-400'
									: 'text-emerald-700 dark:text-emerald-300'
							}`}
						>
							{elapsed}
						</p>
					</li>
				))}
			</ol>
		</section>

		<SquigglyDivider />

		<section class="px-4 text-neutral-700 dark:text-neutral-300">
			<h2 class="text-2xl font-bold text-neutral-900 dark:text-white">
				⚖️ Pacing options
			</h2>
			<p class="mt-2">Both options finish in {target.time}.</p>
			<div class="mt-4 grid gap-4 sm:grid-cols-2">
				{strategies.map(
					({
						name,
						description: strategyDescription,
						firstHalfPace,
						secondHalfPace,
						halfwayTime,
					}) => (
						<article class="rounded-2xl bg-white p-5 shadow dark:bg-neutral-800">
							<h3 class="text-lg font-semibold text-neutral-900 dark:text-white">
								{name}
							</h3>
							<p class="mt-1 text-sm">{strategyDescription}</p>
							<dl class="mt-4 flex flex-col gap-2">
								<div class="flex justify-between gap-4">
									<dt>First half</dt>
									<dd class="font-bold tabular-nums text-emerald-700 dark:text-emerald-300">
										{firstHalfPace} per km
									</dd>
								</div>
								<div class="flex justify-between gap-4">
									<dt>Second half</dt>
									<dd class="font-bold tabular-nums text-emerald-700 dark:text-emerald-300">
										{secondHalfPace} per km
									</dd>
								</div>
								<div class="flex justify-between gap-4 border-t border-neutral-200 pt-2 dark:border-neutral-700">
									<dt>Halfway</dt>
									<dd class="font-bold tabular-nums text-amber-700 dark:text-amber-400">
										{halfwayTime}
									</dd>
								</div>
							</dl>
						</article>
					),
				)}
			</div>
			<p class="mt-4">{marginNote}</p>
		</section>

		<SquigglyDivider />

		<section class="flex-1 px-4">
			<PaceTable
				title={`Finish times near ${threshold}`}
				entries={nearbyEntries}
				highlightTime={target.time}
			/>
			<p class="text-center text-neutral-700 dark:text-neutral-300">
				<Link href={`/run/${distanceSlug}`} variant="accent">
					{chartLinkText}
				</Link>
			</p>
		</section>
	</main>
	<Footer />
</Layout>
