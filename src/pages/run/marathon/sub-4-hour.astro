---
import Footer from '~/components/Footer.astro'
import Link from '~/components/Link.astro'
import PaceTable from '~/components/PaceTable.astro'
import RunHeader from '~/components/RunHeader.astro'
import SquigglyDivider from '~/components/SquigglyDivider.astro'
import Layout from '~/layouts/Layout.astro'
import { generateWebPageSchema } from '~/lib/structured-data'
import { subFourMarathon } from '~/running/data'
import {
	type Checkpoint,
	formatTime,
	generatePaceEntries,
	generateSplits,
	getPaceEntry,
	hms,
	MARATHON_KM,
} from '~/running/utils'

const { path, label, finishSeconds } = subFourMarathon

const halfKm = MARATHON_KM / 2
const paceSeconds = finishSeconds / MARATHON_KM
const goal = getPaceEntry(finishSeconds, MARATHON_KM)
const speed = (MARATHON_KM / (finishSeconds / 3600)).toFixed(1)
const lapTime = formatTime(paceSeconds * 0.4)
const wholeSecondPace = Math.round(paceSeconds)
const wholeSecondPaceFinish = formatTime(wholeSecondPace * MARATHON_KM)
const slowerPace = formatTime(wholeSecondPace + 1)
const slowerPaceFinish = formatTime((wholeSecondPace + 1) * MARATHON_KM)

// A string, because Astro drops a line break between an expression and text.
const marginNote = [
	`Holding ${goal.pacePerKm} per km for ${MARATHON_KM} km gives a finish of ${wholeSecondPaceFinish}.`,
	`A pace of ${slowerPace} per km is already too slow. It gives ${slowerPaceFinish}.`,
	`Most runners cover more than ${MARATHON_KM} km, because they cannot run the shortest line.`,
	'Plan a few seconds per km of margin.',
].join(' ')

const stats = [
	{ value: goal.pacePerKm, unit: 'per km' },
	{ value: goal.pacePerMile, unit: 'per mile' },
	{ value: speed, unit: 'km/h' },
	{ value: lapTime, unit: '400 m lap' },
]

const kilometerCheckpoint = (distance: number): Checkpoint => ({
	label: `${distance} km`,
	distance,
})

const checkpoints: Checkpoint[] = [
	...[5, 10, 15, 20].map(kilometerCheckpoint),
	{ label: 'Half marathon', distance: halfKm, isMilestone: true },
	...[25, 30, 35, 40].map(kilometerCheckpoint),
	{ label: 'Finish', distance: MARATHON_KM, isMilestone: true },
]
const splits = generateSplits(checkpoints, paceSeconds)

const negativeSplitFirstHalf = hms(2, 1)
const negativeSplitSecondHalf = finishSeconds - negativeSplitFirstHalf
const strategies = [
	{
		name: 'Even pace',
		description: 'Run every kilometer at the same pace.',
		firstHalfPace: goal.pacePerKm,
		secondHalfPace: goal.pacePerKm,
		halfwayTime: formatTime(halfKm * paceSeconds),
	},
	{
		name: 'Negative split',
		description:
			'Run the second half about 2 minutes faster than the first half.',
		firstHalfPace: getPaceEntry(negativeSplitFirstHalf, halfKm).pacePerKm,
		secondHalfPace: getPaceEntry(negativeSplitSecondHalf, halfKm).pacePerKm,
		halfwayTime: formatTime(negativeSplitFirstHalf),
	},
]

const nearbyEntries = [
	...generatePaceEntries(
		{ fastest: hms(3, 30), slowest: hms(3, 55), step: 300 },
		MARATHON_KM,
	),
	goal,
	...generatePaceEntries(
		{ fastest: hms(4, 5), slowest: hms(4, 30), step: 300 },
		MARATHON_KM,
	),
]

const pageTitle = `${label} Pace`
const description = `A sub 4 hour marathon needs a pace of ${goal.pacePerKm} per kilometer or ${goal.pacePerMile} per mile. See the splits for every 5 kilometers, two pacing options and finish times near 4 hours.`
const structuredData = generateWebPageSchema({
	name: pageTitle,
	description,
	url: new URL(path, Astro.site).href,
})
---

<Layout
	title={`${pageTitle}: ${goal.pacePerKm} per km, ${goal.pacePerMile} per mile - Tomas Klingen`}
	description={description}
	structuredData={structuredData}
>
	<main class="container mx-auto flex flex-col transition-colors">
		<RunHeader title={pageTitle} currentPath={path} />

		<section class="px-4 pt-6">
			<div class="rounded-2xl bg-linear-to-br from-emerald-700 to-emerald-900 p-6 text-white shadow-xl md:p-8 dark:from-emerald-600/30 dark:to-neutral-800 dark:ring-1 dark:ring-emerald-400/30">
				<p class="text-sm font-semibold uppercase tracking-widest text-emerald-100 dark:text-emerald-300">
					My goal
				</p>
				<p class="mt-2 font-header text-6xl font-bold tabular-nums sm:text-7xl">
					{goal.time}
				</p>
				<p class="mt-3 text-emerald-50 dark:text-neutral-200">
					I have not run a marathon yet. My goal for the first one is a finish
					under 4 hours. That is a pace of {goal.pacePerKm} per km or faster for{' '}
					{MARATHON_KM} km.
				</p>
				<dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
					{stats.map(({ value, unit }) => (
						<div class="rounded-xl bg-white/10 p-4 ring-1 ring-white/20">
							<dt class="text-xs font-semibold uppercase tracking-wide text-emerald-100 dark:text-emerald-300">
								{unit}
							</dt>
							<dd class="mt-1 font-header text-3xl font-bold tabular-nums">
								{value}
							</dd>
						</div>
					))}
				</dl>
			</div>
		</section>

		<SquigglyDivider />

		<section class="px-4 text-neutral-700 dark:text-neutral-300">
			<h2 class="text-2xl font-bold text-neutral-900 dark:text-white">
				🏁 Splits at even pace
			</h2>
			<p class="mt-2">
				Hold {goal.pacePerKm} per km to pass each checkpoint at the time shown.
				Use the list as a pace band on race day.
			</p>
			<ol class="mt-6 rounded-2xl bg-white p-4 shadow dark:bg-neutral-800">
				{splits.map(({ label: splitLabel, miles, elapsed, isMilestone }) => (
					<li class="relative flex items-center justify-between gap-4 py-3 pl-8 before:absolute before:inset-y-0 before:left-[7px] before:w-0.5 before:bg-emerald-200 first:before:top-1/2 last:before:bottom-1/2 dark:before:bg-emerald-900">
						<span
							aria-hidden="true"
							class={`absolute left-0 top-1/2 size-4 -translate-y-1/2 rounded-full ring-4 ring-white dark:ring-neutral-800 ${
								isMilestone
									? 'bg-amber-400 dark:bg-amber-500'
									: 'bg-emerald-500 dark:bg-emerald-400'
							}`}
						/>
						<div>
							<p
								class={`font-semibold text-neutral-900 dark:text-white ${
									isMilestone ? 'text-lg' : ''
								}`}
							>
								{splitLabel}
							</p>
							<p class="text-sm text-neutral-500 dark:text-neutral-400">
								{miles} mi
							</p>
						</div>
						<p
							class={`font-header text-2xl font-bold tabular-nums ${
								isMilestone
									? 'text-amber-700 dark:text-amber-400'
									: 'text-emerald-700 dark:text-emerald-300'
							}`}
						>
							{elapsed}
						</p>
					</li>
				))}
			</ol>
		</section>

		<SquigglyDivider />

		<section class="px-4 text-neutral-700 dark:text-neutral-300">
			<h2 class="text-2xl font-bold text-neutral-900 dark:text-white">
				⚖️ Pacing options
			</h2>
			<p class="mt-2">Both options finish in {goal.time}.</p>
			<div class="mt-4 grid gap-4 sm:grid-cols-2">
				{strategies.map(
					({
						name,
						description: strategyDescription,
						firstHalfPace,
						secondHalfPace,
						halfwayTime,
					}) => (
						<article class="rounded-2xl bg-white p-5 shadow dark:bg-neutral-800">
							<h3 class="text-lg font-semibold text-neutral-900 dark:text-white">
								{name}
							</h3>
							<p class="mt-1 text-sm">{strategyDescription}</p>
							<dl class="mt-4 flex flex-col gap-2">
								<div class="flex justify-between gap-4">
									<dt>First half</dt>
									<dd class="font-bold tabular-nums text-emerald-700 dark:text-emerald-300">
										{firstHalfPace} per km
									</dd>
								</div>
								<div class="flex justify-between gap-4">
									<dt>Second half</dt>
									<dd class="font-bold tabular-nums text-emerald-700 dark:text-emerald-300">
										{secondHalfPace} per km
									</dd>
								</div>
								<div class="flex justify-between gap-4 border-t border-neutral-200 pt-2 dark:border-neutral-700">
									<dt>Halfway</dt>
									<dd class="font-bold tabular-nums text-amber-700 dark:text-amber-400">
										{halfwayTime}
									</dd>
								</div>
							</dl>
						</article>
					),
				)}
			</div>
			<p class="mt-4">{marginNote}</p>
		</section>

		<SquigglyDivider />

		<section class="flex-1 px-4">
			<PaceTable
				title="Finish times near 4 hours"
				entries={nearbyEntries}
				highlightTime={goal.time}
			/>
			<p class="text-center text-neutral-700 dark:text-neutral-300">
				<Link href="/run/marathon" variant="accent">
					See the full marathon pace chart &rarr;
				</Link>
			</p>
		</section>
	</main>
	<Footer />
</Layout>
