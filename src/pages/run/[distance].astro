---
import type { GetStaticPaths } from 'astro'
import Footer from '~/components/Footer.astro'
import Link from '~/components/Link.astro'
import PaceTable from '~/components/PaceTable.astro'
import Layout from '~/layouts/Layout.astro'
import { generateWebPageSchema } from '~/lib/structured-data'
import { distanceConfig } from '~/running/data'
import {
	type FinishRange,
	formatTime,
	generatePaceEntries,
	getPaceEntry,
} from '~/running/utils'

export const getStaticPaths: GetStaticPaths = () => {
	return distanceConfig.map((config) => ({
		params: { distance: config.slug },
		props: config,
	}))
}

interface Props {
	slug: string
	label: string
	about: string
	distance: number
	exampleSeconds: number
	finishRange: FinishRange
}

const { slug, label, about, distance, exampleSeconds, finishRange } =
	Astro.props

const entries = generatePaceEntries(finishRange, distance)
const example = getPaceEntry(exampleSeconds, distance)
const distanceName = label.toLowerCase()
const usage = `Find your goal finish time in the first column. The next columns show the pace to hold. For example, a ${distanceName} finish time of ${example.time} is a pace of ${example.pacePerKm} per km, or ${example.pacePerMile} per mile.`
const pageTitle = `${label} Pace Chart`
const description = `Pace chart for the ${distanceName} distance. Find your finish time between ${formatTime(finishRange.fastest)} and ${formatTime(finishRange.slowest)} and read the pace per kilometer and per mile.`
const structuredData = generateWebPageSchema({
	name: pageTitle,
	description,
	url: new URL(`/run/${slug}`, Astro.site).href,
})
---

<Layout
	title={`${pageTitle} (min/km and min/mile) - Tomas Klingen`}
	description={description}
	structuredData={structuredData}
>
	<main class="container mx-auto flex flex-col transition-colors">
		<header class="shadow p-4 flex flex-col gap-2 md:flex-row md:items-center md:justify-between border-b border-neutral-200 dark:border-neutral-700">
			<div class="flex items-center gap-4">
				<Link href="/" variant="nav">
					{' '}
					&larr; Home{' '}
				</Link>
				<h1 class="text-2xl font-bold text-neutral-900 dark:text-white">
					{pageTitle}
				</h1>
			</div>
			<hr class="my-2 md:hidden border-neutral-200 dark:border-neutral-800" />
		</header>

		<nav class="bg-white dark:bg-neutral-900 border-b border-neutral-200 dark:border-neutral-800 p-2">
			<ul class="flex flex-wrap gap-2">
				{distanceConfig.map(({ slug: configSlug, label: configLabel }) => (
					<li>
						<Link
							href={`/run/${configSlug}`}
							class={`px-3 py-1 rounded transition-colors font-medium whitespace-nowrap ${
								configSlug === slug
									? 'bg-emerald-700 text-white dark:bg-emerald-400 dark:text-neutral-900'
									: 'text-emerald-700 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/40'
							}`}
						>
							{configLabel}
						</Link>
					</li>
				))}
			</ul>
		</nav>

		<section class="flex flex-col gap-3 px-4 pt-6 text-neutral-700 dark:text-neutral-300">
			<p>{about}</p>
			<p>{usage}</p>
		</section>

		<section class="flex-1">
			<PaceTable title={`${label} Finish Times and Paces`} entries={entries} />
		</section>
	</main>
	<Footer />
</Layout>
